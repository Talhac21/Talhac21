APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*

APP_SECRET_KEY=change-me
SESSION_ENCRYPTION_KEY=replace-with-32-byte-base64-key
API_ADMIN_TOKEN=replace-with-token

POSTGRES_DB=rr_panel
POSTGRES_USER=rr_user
POSTGRES_PASSWORD=rr_password
DATABASE_URL=postgresql+psycopg://rr_user:rr_password@db:5432/rr_panel

REDIS_URL=redis://redis:6379/0

FEATURE_WARS_WATCHLIST=true
FEATURE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

RR_BASE_URL=https://rivalregions.com
PERK_INTERVAL_MINUTES=30
WORKER_POLL_SECONDS=60

NEXT_PUBLIC_API_URL=http://localhost:8000
