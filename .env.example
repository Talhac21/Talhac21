# App
APP_ENV=development
LOG_LEVEL=INFO
FEATURE_WARS_WATCHLIST=true
FEATURE_TELEGRAM=true

# Security
APP_SECRET_KEY=change-me
SESSION_ENCRYPTION_KEY=replace-with-32-byte-base64-key
API_ADMIN_TOKEN=replace-with-long-random-token

# Database
POSTGRES_DB=rr_panel
POSTGRES_USER=rr_user
POSTGRES_PASSWORD=rr_password
DATABASE_URL=postgresql+psycopg://rr_user:rr_password@db:5432/rr_panel

# Redis (optional for distributed locks)
REDIS_URL=redis://redis:6379/0

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
